{
  "manifest_version": 3,
  "name": "NJU 自动登录助手",
  "description": "南大统一身份认证滑块与选课点击验证码本地自动登录助手，无需大模型 API。",
  "version": "6.0.2",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://xk.nju.edu.cn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://authserver.nju.edu.cn/*"],
      "js": ["auth-slider-captcha.js", "auth-login-fast.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://authserver.nju.edu.cn/*"],
      "js": ["captcha-cnn.js", "tesseract.min.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://xk.nju.edu.cn/*"],
      "js": ["content-grab.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "langs/eng.traineddata",
        "langs/worker.min.js",
        "langs/tesseract-core.wasm.js",
        "assets/captcha-template-model.json",
        "assets/captcha-cnn-model.json",
        "assets/captcha-cnn-model.bin",
        "icon48.png"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "click-captcha-worker.js",
        "assets/click-captcha-model.onnx",
        "assets/click-captcha-background.png",
        "vendor/onnxruntime/ort.wasm.bundle.min.js",
        "vendor/onnxruntime/ort-wasm-simd-threaded.mjs",
        "vendor/onnxruntime/ort-wasm-simd-threaded.wasm"
      ],
      "matches": ["https://xk.nju.edu.cn/*"]
    }
  ]
}
